# ---------------------------------------------------------------
# Gear Tractor environment variables
# ---------------------------------------------------------------

# Runtime connection used by the app. Use the restricted application role
# (gt_app) so Postgres row-level security is enforced for every query.
# On Neon use the *pooled* connection string.
DATABASE_URL="postgresql://gt_app:<password>@<host>/<db>?sslmode=require"

# Owner connection used only for migrations and seeding (never exposed to the app runtime).
# On Neon use the *direct* (unpooled) connection string of the database owner.
DATABASE_URL_OWNER="postgresql://<owner>:<password>@<host>/<db>?sslmode=require"

# Password assigned to the gt_app role by `pnpm db:roles`.
APP_DB_PASSWORD="<long-random-password>"

# Public base URL, used for QR codes, invitation and password reset links.
APP_URL="http://localhost:3000"

# Secret used to authorise the scheduled status refresh endpoint (/api/cron/refresh-status).
CRON_SECRET="<long-random-string>"

# Optional: transactional email via Resend. When unset, invitation and reset links
# are shown to admins in the UI and written to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Gear Tractor <no-reply@example.com>"

# Seed credentials (used by `pnpm db:seed`).
SEED_SUPER_ADMIN_EMAIL="super@geartractor.app"
SEED_DEMO_PASSWORD="<demo-password>"
